<!doctype html>
<html lang="en">
<head>
<!-- favicon: same links as the dashboard, added at publish -->
<link rel="icon" type="image/png" sizes="32x32" href="data:image/png;base64,">
<link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" href="data:image/png;base64,">
<link rel="apple-touch-icon" sizes="180x180" href="data:image/png;base64,">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>2026 Hampers &amp; Client Gifts &middot; Hybrid-Ag</title>
<style>
@font-face{font-family:'Alternate Gothic No2 D';font-style:normal;font-weight:400;
  font-display:swap;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'Oswald';font-style:normal;font-weight:400 700;
  font-display:swap;src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'Inter';font-style:normal;font-weight:400 700;
  font-display:swap;src:url(data:font/woff2;base64,) format('woff2')}
:root{
  --display:'Alternate Gothic No2 D','Oswald',sans-serif;
  --oswald:'Oswald','Arial Narrow',sans-serif;
  --teal:#1B9690; --orange:#D9742B; --berry:#8C4F8E;
  --paper:#F4F1EA; --cream:#EAE5DF; --ink:#1A1714; --ink-deep:#131110;
  --muted:#6B665E; --line:#D6D0C7;
  --green:#2E7D4F; --red:#C0392B;
  --r:2px;
  --shadow:0 1px 1px rgba(26,23,20,.04), 0 3px 6px rgba(26,23,20,.05), 0 10px 22px rgba(26,23,20,.06);
}
*{box-sizing:border-box}
body{margin:0;font-family:'Inter',system-ui,sans-serif;background:var(--paper);color:var(--ink);
  font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
.lab,.num,.det,h1,h2,h3,.kick,.ticket,.tag,th,.stamp{font-style:normal}

/* ── masthead ── */
.hero{background:var(--ink-deep);color:#fff;padding:38px 40px 36px;position:relative;overflow:hidden}
.hero::after{content:'';position:absolute;inset:0;
  background:radial-gradient(1100px 420px at 88% -10%, rgba(217,116,43,.16), transparent 60%),
             radial-gradient(900px 420px at 8% 115%, rgba(27,150,144,.13), transparent 55%)}
.hero-in{position:relative;z-index:2;max-width:1520px;margin:0 auto}
.hero .wordmark{height:42px;display:block;margin-bottom:22px}
.hero h1{font-family:var(--display);font-weight:400;font-size:clamp(46px,6vw,84px);
  line-height:.94;letter-spacing:.015em;text-transform:uppercase;color:#fff;margin:0}
.hero .kick{font-family:var(--oswald);font-weight:600;font-size:12px;letter-spacing:.16em;
  color:#E2A15F;text-transform:uppercase;margin:0 0 10px}
.hero p.lede{margin:14px 0 0;max-width:76ch;font-size:15.5px;color:rgba(255,255,255,.82)}
.hero p.lede b{color:#fff;font-weight:600}
.ticket{display:inline-flex;align-items:center;gap:12px;background:#fff;color:var(--ink);
  border-radius:2px;padding:9px 16px;margin-top:24px;box-shadow:0 2px 0 rgba(0,0,0,.4);flex-wrap:wrap}
.ticket .tk-rule{width:1px;align-self:stretch;background:var(--line)}
.ticket .tk-kick{font-family:var(--oswald);font-weight:700;font-size:9.5px;letter-spacing:.14em;
  text-transform:uppercase;color:var(--orange)}
.ticket .tk-main{font-family:var(--oswald);font-weight:600;font-size:12.5px;letter-spacing:.05em;
  text-transform:uppercase}

/* ── section bands ── */
.ops-intro{border-bottom:1px solid var(--line);
  padding:30px max(40px,calc((100% - 1520px)/2)) 22px;margin:0 0 8px}
.ops-intro h2{font-family:'Oswald',sans-serif;font-weight:600;font-size:clamp(26px,3vw,38px);
  line-height:1.05;letter-spacing:-.2px;display:flex;align-items:baseline;gap:14px;margin:0}
.ops-intro h2::before{content:attr(data-n);font-family:var(--display);font-size:.6em;
  color:var(--orange);letter-spacing:.05em;transform:translateY(-1px);text-transform:uppercase}
.ops-intro p{margin:9px 0 0;max-width:84ch;color:var(--muted);font-size:14.5px}

/* ── KPI tiles ── */
.kpis{display:grid;grid-template-columns:repeat(6,1fr);
  column-gap:30px;row-gap:22px;padding:28px max(40px,calc((100% - 1350px)/2)) 12px;max-width:1350px;margin:0 auto}
.kpi{position:relative;padding:3px 0 4px 15px}
.kpi::before{content:'';position:absolute;top:5px;bottom:7px;left:0;width:3px;background:var(--ink)}
.kpi.k-teal::before{background:var(--teal)} .kpi.k-orn::before{background:var(--orange)}
.kpi.k-berry::before{background:var(--berry)} .kpi.k-green::before{background:var(--green)}
.kpi .lab{font-family:var(--oswald);font-size:10.5px;font-weight:700;letter-spacing:.14em;
  text-transform:uppercase;color:var(--muted)}
.kpi .num{font-family:'Oswald',sans-serif;font-size:clamp(28px,2.6vw,42px);font-weight:600;
  line-height:1.06;letter-spacing:-.01em;font-variant-numeric:tabular-nums;margin-top:3px}
.kpi .det{font-size:12.5px;color:var(--muted);margin-top:3px}

/* ── content blocks ── */
.blk{padding:26px max(40px,calc((100% - 1520px)/2)) 6px;scroll-margin-top:10px}
.blk .inner{max-width:1520px;margin:0 auto}
h3.sub{font-family:var(--oswald);font-weight:700;font-size:11px;letter-spacing:.18em;
  text-transform:uppercase;color:var(--muted);margin:0 0 12px;display:flex;align-items:center;gap:12px}
h3.sub::after{content:'';flex:1;height:1px;background:var(--line)}
p{margin:0 0 12px} ul,ol{margin:0 0 14px;padding-left:20px} li{margin-bottom:7px}
a{color:var(--teal)}
.lead{font-size:16px;max-width:86ch}

.lgroup{border-radius:var(--r);overflow:hidden;background:var(--cream);margin-bottom:20px}
.lgroup-h{padding:12px 14px 9px;color:var(--ink);border-bottom:2px solid var(--ink);margin:0 2px;
  display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap}
.lgroup-h h4{font-family:var(--oswald);font-weight:700;font-size:13px;letter-spacing:.1em;
  text-transform:uppercase;margin:0}
.lgroup-h .meta{font-size:12px;color:var(--muted)}
.lgroup-b{padding:14px}
.lgroup-b p:last-child{margin-bottom:0}

.sheet{background:#fff;border:1px solid var(--line);border-radius:var(--r);
  box-shadow:var(--shadow);padding:15px 17px;position:relative}
.sheet::before{content:'';position:absolute;top:0;bottom:0;left:0;width:3px;background:var(--a,var(--teal))}
.sheet h4{font-family:var(--oswald);font-weight:700;font-size:11.5px;letter-spacing:.12em;
  text-transform:uppercase;color:var(--a,var(--teal));margin:0 0 7px}
.sheet p{font-size:13.5px;margin:0 0 8px}
.sheet ul{font-size:13.5px;margin:0;padding-left:18px}
.sheet p:last-child{margin-bottom:0}
.grid{display:grid;gap:16px;margin:0 0 16px}
.g2{grid-template-columns:repeat(2,1fr)} .g3{grid-template-columns:repeat(3,1fr)} .g4{grid-template-columns:repeat(4,1fr)}
.rot > .sheet:nth-child(3n+1){--a:var(--teal)}
.rot > .sheet:nth-child(3n+2){--a:var(--orange)}
.rot > .sheet:nth-child(3n+3){--a:var(--berry)}
@media(max-width:1100px){.g4{grid-template-columns:repeat(2,1fr)}}
@media(max-width:1000px){.kpis{grid-template-columns:repeat(3,1fr)}}
@media(max-width:600px){.kpis{grid-template-columns:repeat(2,1fr)}}
@media(max-width:900px){.g3,.g2,.g4{grid-template-columns:1fr}}

.tw{background:#fff;border:1px solid var(--line);border-radius:var(--r);
  box-shadow:var(--shadow);overflow-x:auto;margin:0 0 18px}
table{border-collapse:collapse;width:100%;font-size:12.5px;min-width:560px}
th{font-family:var(--oswald);font-size:10.5px;font-weight:700;letter-spacing:.1em;
  text-transform:uppercase;color:var(--ink);text-align:left;padding:8px 12px;
  border-bottom:1.5px solid var(--ink);background:var(--cream);white-space:nowrap}
td{padding:8px 12px;border-bottom:1px solid #F3EFE6;vertical-align:top}
th.n,td.n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
tbody tr:last-child td{border-bottom:0}
.allocation-group summary .small{display:block;margin-top:5px;letter-spacing:0;text-transform:none}
.allocation-table td:first-child{width:28%}
.allocation-note{white-space:normal;overflow-wrap:anywhere}
.allocation-pending{display:inline-block;color:var(--berry);font-weight:600;margin-top:6px}
@media(max-width:600px){
  .tw .allocation-table{display:block;min-width:0}
  .allocation-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  .allocation-table tbody{display:block}
  .allocation-table tr{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--line);padding:8px 0}
  .allocation-table tr:last-child{border-bottom:0}
  .allocation-table td{display:block;border:0;padding:5px 12px}
  .allocation-table td:first-child{grid-column:1/-1;width:auto;font-weight:600}
  .allocation-table td.n{text-align:left}
  .allocation-table td[data-label]::before{content:attr(data-label) ": ";color:var(--muted);font-weight:400}
  .allocation-table .allocation-note{grid-column:1/-1}
}
.tag{display:inline-block;font-family:var(--oswald);font-weight:700;font-size:9.5px;
  letter-spacing:.1em;text-transform:uppercase;padding:3px 8px;border-radius:2px;color:#fff}
.tag.go{background:var(--green)} .tag.new{background:var(--orange)} .tag.hold{background:var(--muted)}
.tag.prem{background:var(--berry)} .tag.std{background:var(--teal)}

.note{background:var(--cream);border-left:3px solid var(--a,var(--orange));padding:14px 18px;
  margin:0 0 18px;border-radius:0 var(--r) var(--r) 0}
.note.t{--a:var(--teal)} .note.b{--a:var(--berry)} .note.r{--a:var(--red)}
.note h4{font-family:var(--oswald);font-weight:700;font-size:11px;letter-spacing:.14em;
  text-transform:uppercase;color:var(--a,var(--orange));margin:0 0 7px}
.note.r h4{color:var(--red)}
.note p:last-child,.note ul:last-child{margin-bottom:0}
.note ul{margin:0;padding-left:19px} .note li{font-size:14px}

/* tier flat-lays */
.tierlays{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:0 0 18px}
.tierlays figure{margin:0;background:#fff;border:1px solid var(--line);border-radius:var(--r);
  box-shadow:var(--shadow);overflow:hidden}
.tierlays img{width:100%;height:auto;display:block}
.tierlays figcaption{padding:10px 14px 12px;border-top:1px solid var(--line)}
.tierlays .fc{font-family:var(--oswald);font-weight:700;font-size:11.5px;letter-spacing:.12em;text-transform:uppercase}
.tierlays .fd{font-size:12.5px;color:var(--muted);margin-top:2px}
@media(max-width:900px){.tierlays{grid-template-columns:1fr}}

/* sessions */
.session{display:grid;grid-template-columns:minmax(340px,46%) 1fr;gap:20px;margin:0 0 26px;align-items:start}
.session .vid{position:relative;background:#000;border-radius:var(--r);overflow:hidden;
  box-shadow:var(--shadow);aspect-ratio:16/9}
.session .vid iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.session .s-kick{font-family:var(--oswald);font-weight:700;font-size:10.5px;letter-spacing:.14em;
  text-transform:uppercase;color:var(--a,var(--teal));margin:0 0 4px}
.session h4{font-family:'Oswald',sans-serif;font-weight:600;font-size:19px;margin:0 0 4px}
.session .s-meta{font-size:12.5px;color:var(--muted);margin:0 0 10px}
.session ul{font-size:13.5px;margin:0;padding-left:18px}
.session li{margin-bottom:6px}
@media(max-width:1000px){.session{grid-template-columns:1fr}}

/* timeline */
.tl tr.now td{background:#fbf4e8}
.tl td:first-child{font-family:var(--oswald);font-weight:600;font-size:12px;letter-spacing:.06em;
  text-transform:uppercase;white-space:nowrap}

.src{font-size:12.5px;color:var(--muted);border-top:1px solid var(--line);margin-top:26px;padding-top:16px}
.src li{margin-bottom:5px}

.footer{background:var(--ink-deep);color:#fff;margin-top:48px}
.footer-in{max-width:1520px;margin:0 auto;padding:24px 40px;display:flex;
  justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.footer .wordmark{height:30px;display:block}
.footer .f-note{font-size:12.5px;color:rgba(255,255,255,.62)}
.tricolour{display:flex;height:4px}
.tricolour i{flex:1}
.tricolour i:nth-child(1){background:var(--teal)}
.tricolour i:nth-child(2){background:var(--orange)}
.tricolour i:nth-child(3){background:var(--berry)}
blockquote{margin:0 0 14px;padding:12px 18px;background:#fff;border-left:3px solid var(--berry);
  border-radius:0 var(--r) var(--r) 0;box-shadow:var(--shadow);font-size:14.5px;max-width:78ch}
blockquote .who{display:block;margin-top:6px;font-size:12px;color:var(--muted)}
.current-kpis{grid-template-columns:repeat(4,1fr)}
.jump{max-width:1520px;margin:0 auto;padding:18px 40px 0;display:flex;gap:10px 24px;flex-wrap:wrap}
.jump a{font-size:13px;text-underline-offset:4px}
.gift-tier{padding:24px;border-top:4px solid var(--a,var(--teal));align-self:start}
.gift-tier::before{display:none}
.gift-tier .price{font-family:var(--oswald);font-size:48px;line-height:1.1;margin:8px 0 2px}
.gift-tier .budget{color:var(--muted);font-size:12.5px;margin-bottom:18px}
.gift-tier li{margin-bottom:10px}
.opt-photos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:0 0 16px}
.opt-photos img{display:block;width:100%;height:96px;object-fit:contain;background:#fff;border:1px solid var(--line);padding:4px}
.gift-tier .tag{margin-right:6px}
.gift-tier .remain{font-weight:600;color:var(--teal);margin:12px 0 0}
.gift-tier .remain.over{color:var(--red)}
.gift-total{border-top:1px solid var(--line);padding-top:12px;margin-top:16px;font-weight:600}
.premium-alt{border-top:1px solid var(--line);margin-top:20px;padding-top:16px}
.premium-alt>summary{font-family:var(--oswald);font-size:18px;cursor:pointer;color:var(--berry)}
.premium-alt .alt-body{padding-top:14px}
.jacket-deal{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 24px;background:var(--cream);padding:14px;margin:0 0 18px}
.jacket-deal span{font-size:12.5px;color:var(--muted)}
.jacket-deal b,.jacket-deal s{display:block;font-family:var(--oswald);font-size:26px;line-height:1.2;margin-top:3px}
.jacket-deal b{color:var(--teal)}
.jacket-deal .saving{grid-column:1/-1;font-weight:600;color:var(--green)}
.jacket-alt+.jacket-alt{border-top:1px solid var(--line);padding-top:14px;margin-top:14px}
.jacket-alt h5{font-family:var(--oswald);font-size:16px;margin:0 0 7px}
.jacket-history{list-style:none;padding:0!important;margin:0!important}
.jacket-history li{border-bottom:1px solid var(--line);padding:10px 0;margin:0;font-size:13.5px}
.jacket-history li:last-child{border-bottom:0;padding-bottom:0}
.jacket-history a{font-weight:600}
.history-price,.history-note{display:block;margin-top:3px}
.history-price{font-weight:600;color:var(--ink)}
.survey-draft{background:#fff;border:1px solid var(--line);padding:24px;margin:20px 0;box-shadow:var(--shadow)}
.survey-draft .tw{box-shadow:none;margin-top:16px}
.survey-draft th:last-child,.survey-draft td:last-child{width:150px}
.survey-draft .response{white-space:nowrap;color:var(--muted)}
.small{font-size:12.5px;color:var(--muted)}
.email-draft{max-width:760px;background:#fff;border:1px solid var(--line);padding:24px;box-shadow:var(--shadow)}
.email-draft .subject{font-weight:600;padding-bottom:12px;border-bottom:1px solid var(--line);margin-bottom:18px}
.quote-summary .price{font-family:var(--oswald);font-size:26px;line-height:1.2;margin:8px 0}
.quote-detail{border:1px solid var(--line);background:#fff;margin-bottom:16px}
.quote-detail>summary{padding:16px 18px;font-family:var(--oswald);font-size:18px;cursor:pointer;background:var(--cream)}
.quote-body{padding:20px 18px 4px}
.quote-photos{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:0 0 20px}
.quote-photos figure{margin:0;border:1px solid var(--line);background:#fff;min-width:0}
.quote-photos img{display:block;width:100%;height:200px;object-fit:contain;background:#fff;padding:12px}
.quote-photos figcaption{padding:10px 12px;border-top:1px solid var(--line);font-size:12.5px}
.quote-photos figcaption b{display:block;margin-bottom:4px}
.photo-pair{display:grid;grid-template-columns:1fr 1fr}
.yeti-photos{grid-template-columns:repeat(2,minmax(0,1fr))}
.yeti-photos img{height:250px}
.sock-concepts{margin:0 0 18px;border:1px solid var(--line)}
.sock-concepts img{display:block;width:100%;height:auto}
.sock-concepts figcaption{padding:12px 14px;border-top:1px solid var(--line);font-size:12.5px;color:var(--muted)}
@media(max-width:1000px){.quote-photos{grid-template-columns:repeat(2,minmax(0,1fr))}}
.archive{margin:32px 0 0;border-top:1px solid var(--line)}
.archive>summary{padding:25px max(40px,calc((100% - 1520px)/2));font-family:var(--oswald);font-size:22px;cursor:pointer;background:var(--cream)}
.archive>summary small{display:block;font-family:'Inter',sans-serif;font-size:13px;color:var(--muted);margin-top:5px}
.hero{border-top:4px solid var(--teal)}
.hero a{color:#fff}
:focus-visible{outline:2px solid var(--teal);outline-offset:4px}
@media(max-width:700px){
  .hero{padding:28px 22px}.hero h1{font-size:52px}
  .ops-intro,.blk{padding-left:22px;padding-right:22px}
  .kpis{padding-left:22px;padding-right:22px;column-gap:18px}
  .current-kpis{grid-template-columns:repeat(2,1fr)}
  .jump{padding-left:22px;padding-right:22px;gap:10px 18px}
  .gift-tier{padding:20px}.email-draft,.survey-draft{padding:20px}
  .survey-draft .tw table{min-width:0}.survey-draft .response{white-space:normal}
  .archive>summary{padding:22px}.footer-in{padding:24px 22px}
  .ops-intro h2{gap:10px}.tw table{min-width:620px}
  .yeti-photos{grid-template-columns:1fr}.quote-body{padding:16px 12px 0}
  .quote-photos img{height:150px;padding:8px}.yeti-photos img{height:220px}
}

.proposed-tiers{align-items:start}
.tier-photo{margin:16px 0;background:#fff;border:1px solid var(--line)}
.tier-photo img{width:100%;height:auto;display:block}
.tier-photo figcaption{font-size:11.5px;color:var(--muted);padding:8px 10px;border-top:1px solid var(--line)}
.tier-items{min-width:0;table-layout:auto}
.tier-items th,.tier-items td{padding:9px 8px}
.tier-items td:first-child{overflow-wrap:anywhere}
.tier-items th.n,.tier-items td.n{width:68px}
.tier-items th:last-child,.tier-items td:last-child{width:45px}
.tier-upgrade{margin-top:22px;padding-top:18px;border-top:3px solid var(--orange)}
.tier-upgrade h5{font-family:var(--oswald);font-size:17px;color:var(--orange);margin:0 0 8px}
.upgrade-price{font-family:var(--oswald);font-size:32px;line-height:1.2;margin-bottom:10px}
.upgrade-price span{font-family:'Inter',sans-serif;font-size:12.5px;color:var(--muted);display:block;margin-top:5px}
.packaging-choice{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:28px;align-items:center;background:#fff;border:1px solid var(--line);padding:24px;margin-bottom:26px}
.packaging-choice h3{font-family:var(--oswald);font-size:28px;margin:8px 0}
.packaging-choice .bag-price{font-family:var(--oswald);font-size:44px;line-height:1.15;color:var(--teal);margin:12px 0}
.packaging-choice .bag-price span{display:block;font:13px/1.5 'Inter',sans-serif;color:var(--muted);margin-top:5px}
.modena-concept{margin:0}
.modena-mockup{position:relative;overflow:hidden;aspect-ratio:27/35;background:#fff;max-width:360px;margin:auto}
.modena-mockup .bag-source{display:block;width:100%;height:auto}
.modena-concept figcaption{font-size:12px;color:var(--muted);max-width:44ch;margin:8px auto 0}
.packaging-options h4{font-family:var(--oswald);font-size:19px;margin:0 0 8px}
.packaging-options .option-price{font-family:var(--oswald);font-size:25px;color:var(--teal);margin-bottom:10px}
.packaging-options p:last-child{margin-bottom:0}
.packaging-boards{margin-top:26px;border:1px solid var(--line);background:#fff}
.packaging-boards>summary{font-family:var(--oswald);font-size:19px;cursor:pointer;padding:16px 20px;background:var(--cream)}
.packaging-boards .boards{padding:20px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.packaging-boards figure{margin:0;min-width:0}
.packaging-boards img{display:block;width:100%;height:auto;border:1px solid var(--line)}
.packaging-boards figcaption{font-size:12px;color:var(--muted);margin-top:8px}
@media(max-width:700px){.packaging-choice{grid-template-columns:1fr;padding:18px;gap:20px}.modena-mockup{max-width:280px}.packaging-boards .boards{grid-template-columns:1fr;padding:14px}}
@media(max-width:700px){.tier-items{font-size:12px}.tier-items th,.tier-items td{padding:8px 5px}.tier-items .small{font-size:11px}}

</style>
</head>
<body>

<header class="hero page">
  <div class="hero-in">
    <img class="wordmark" src="data:image/png;base64," alt="Hybrid-Ag">
    <p class="kick">2026 end-of-year gifts &middot; Give-back &middot; Pillar 6</p>
    <h1>Hampers &amp;<br>Client Gifts 2026</h1>
    <p class="lede">Pia&rsquo;s itemised proposals bring the jacket, useful branded items and supplied photos together.
      Both tiers now use the same black Kathmandu Epiq jacket, with a Modena tote provisionally added to each gift. The Macpac Halo remains a lower-cost Tier 2 alternative if we need to reduce the budget.
      <b>Two proposed tiers for Amos&rsquo;s review. Final team allocations are now in. Complete costs, the remaining client notes and approval to order are still pending.</b></p>
    <div class="ticket">
      <span class="tk-kick">Allocation &amp; survey update &middot; 9 October 2026</span>
      <span class="tk-rule"></span>
      <span class="tk-main">Ready for Amos review</span>
      <span class="tk-rule"></span>
      <span class="tk-main" style="color:var(--orange)">Final team allocations received</span>
    </div>
  </div>
</header>

<div class="kpis current-kpis">
  <div class="kpi k-teal"><div class="lab">Final team allocation</div><div class="num">133</div><div class="det">50 Tier 1 + 83 Tier 2 gifts</div></div>
  <div class="kpi k-berry"><div class="lab">Tier 1 item subtotal</div><div class="num">$311.87</div><div class="det">Per gift &middot; $400 budget target</div></div>
  <div class="kpi k-teal"><div class="lab">Tier 2 item subtotal</div><div class="num">$208.78</div><div class="det">$8.78 over target &middot; Macpac alternative: $171.98</div></div>
  <div class="kpi k-orn"><div class="lab">Working item spend</div><div class="num">$32,922.24</div><div class="det">Includes Modena bags &middot; $29,867.84 with Macpac</div></div>
</div>

